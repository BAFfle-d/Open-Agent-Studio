# Relay server configuration (copy to your process manager / container env).
PORT=8787
HOST=0.0.0.0
# One or more pets: petId:token pairs. Generate a token with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ROOM_TOKENS=blurb:replace-with-a-long-random-token
# Serve the fan web app from the same origin (build it with `npm run build -w @blurb/web`).
WEB_DIST=../web/dist
# Only set to 1 behind a reverse proxy you control (nginx/Caddy) that sets X-Forwarded-For.
TRUST_PROXY=0
MAX_VIEWERS=500
MAX_CONNS_PER_IP=6
# Extra words to block in fan chat, comma-separated.
BLOCKLIST=
