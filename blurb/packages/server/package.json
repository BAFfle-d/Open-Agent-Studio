{
  "name": "@blurb/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/main.js --packages=external --alias:@blurb/shared=../shared/src/index.ts"
  },
  "dependencies": {
    "@blurb/shared": "*",
    "@fastify/static": "^10.1.0",
    "fastify": "^5.12.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.0"
  }
}
